{
  "name": "grand-strategy-graph",
  "version": "2.0.0",
  "private": true,
  "description": "Obsidian plugin: Grand Strategy bet creator and data-driven strategy graph.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "esbuild tools/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=.build/migrate.mjs --log-level=warning && node .build/migrate.mjs",
    "dev:web": "vite --config dev/vite.config.ts --configLoader runner",
    "test:e2e": "playwright test",
    "screenshots": "node tools/readme-screenshots.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  }
}
